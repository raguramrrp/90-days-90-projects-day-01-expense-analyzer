# Personal Expense Intelligence Configuration
# Copy this file to .env if you wish to override default database and application settings.

# Path to SQLite database file (default is expenses.db in project root)
EXPENSE_DB_PATH=expenses.db

# Currency symbol for dashboard rendering
CURRENCY_SYMBOL=$

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
